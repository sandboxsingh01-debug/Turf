# Copy this file to .env.local and fill in real values.
# Never commit .env.local or real secrets to version control.

# --- Database (relational — e.g. Postgres via Neon/Supabase) ---
# Connection string for the application's relational database.
DATABASE_URL=

# --- Authentication ---
# Secret used to sign session tokens. Generate with: openssl rand -base64 32
AUTH_SECRET=

# --- Application ---
# Public base URL of the deployed app, used for links in emails/SMS.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Notifications (optional, for future booking confirmations) ---
# SMS_PROVIDER_API_KEY=
# EMAIL_PROVIDER_API_KEY=
